/**
 * entry 模块级构建配置
 * 声明模块的编程模型、资源处理选项、混淆规则与构建目标，
 * 由 hvigor 构建系统读取
 */
{
  // 编程模型：stage 模型（当前主推的应用开发模型）
  "apiType": "stageMode",
  // 默认构建选项
  "buildOption": {
    // 资源处理选项
    "resOptions": {
      // 是否复制代码资源（多语言场景使用），当前关闭
      "copyCodeResource": {
        "enable": false
      }
    }
  },
  // 构建选项集：为不同构建模式提供差异化选项
  "buildOptionSet": [
    {
      // release 模式专属选项
      "name": "release",
      "arkOptions": {
        // ArkTS 代码混淆配置
        "obfuscation": {
          "ruleOptions": {
            // 当前未启用混淆（混淆规则见 obfuscation-rules.txt）
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    },
  ],
  // 模块构建目标：default 为应用产物，ohosTest 为设备仪器测试产物
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "ohosTest"
    }
  ]
}
